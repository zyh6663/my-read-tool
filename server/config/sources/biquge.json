{
  "name": "远程书库",
  "base_url": "http://38.76.213.204:8899",
  "enabled": true,
  "priority": 10,
  "is_builtin": true,
  "id": 0,
  "rule_json": {
    "response_type": "json",
    "search": {
      "url": "/api/books/search?q={keyword}",
      "method": "GET",
      "list_selector": "$.books[*]",
      "fields": {
        "title": "$.name",
        "book_id": "$.path"
      }
    },
    "detail": {
      "url": "/api/books/chapters?path={book_id}",
      "method": "GET",
      "chapter_list_selector": "div.chapter-list a.chapter-item",
      "chapter_title_selector": "",
      "chapter_url_selector": "",
      "next_page_selector": ""
    },
    "chapter": {
      "content_selector": "div.chapter-content",
      "title_selector": "h1.chapter-title",
      "remove_selectors": []
    }
  }
}