  "base_url": "https://www.bqg3.cc",
  "rule_json": "{\"search\":{\"url\":\"https://www.bqg3.cc/search.php?keyword={keyword}\",\"method\":\"GET\",\"list_selector\":\".search-list .book\",\"fields\":{\"book_id\":\"a.book-title\",\"title\":\"a.book-title\",\"author\":\".book-author\",\"description\":\".book-desc\",\"cover_url\":\"img.book-cover\"}},\"detail\":{\"chapter_list_selector\":\"#list dd a\",\"fields\":{\"title\":\"h1\",\"author\":\".author\",\"description\":\"#intro\",\"cover_url\":\"#fmimg img\"}},\"chapter_content\":{\"content_selector\":\"#content\",\"remove_selectors\":[\"script\",\".ad\"]}}",
  "enabled": true,
  "priority": 10,
